//Q.To check the given number is harshad number or not 
//example 18
//1.get input as 18
//2.find the sum of digits sum = 1+8 = 9
//3.to check given number is completely divisible by sum of digits
//4.18%9 == 0 if it is true print harshad number

import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj = new Scanner(System.in);
	    int n = obj.nextInt();
	    int d;
	    int temp = n;
	    int sum = 0;
	    while(n!=0){
	        d = n%10;
	        sum+=d;
	        n=n/10;
	    }
	    if(temp%sum==0){
	        System.out.print("Harshad");
	}
	else{
	    System.out.print("Not a Harshad");
	}
	    }
		
}

// To check whether it is neon number or not

