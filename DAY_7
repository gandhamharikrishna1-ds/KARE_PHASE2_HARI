// Io find perfect number
// 1.get user input n = 6
// 2.find the factor of n value including 1 and excluding the given number
// 3.find the sum of factors sum = (1+2+3) = 6
// 4.compare sum and given number
// 5.if both are equal print perfect number else not a perfect number
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj = new Scanner(System.in);
	    int n = obj.nextInt();
	    int i;
	    int temp = n;
	    int sum = 0;
	    for(i=1;i<=n/2;i++){
	        if(n%i==0)
	            sum+=i;
	    }
	    if(n==sum)
	        System.out.print("Perfect number");
	    else
	        System.out.print("Not a Perfect number");
	}
	    
		

}

